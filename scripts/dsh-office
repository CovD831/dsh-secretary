#!/usr/bin/env python3
"""Manage the standalone Pixel Office service profile (ensuring officePort=4320 and checking loopback readiness)."""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
SUPERAGENT_SCRIPT = ROOT / 'scripts' / 'dsh-superagent'
DEFAULT_OFFICE_PORT = 4320


def resolve_dsh_home():
    raw = os.environ.get('DSH_HOME', '').strip()
    if raw:
        return Path(raw).expanduser().resolve()
    return Path.home() / '.dsh'


def ensure_office_port(profile, port):
    """Ensure the target DSH profile's cordis.patch.yml sets `officePort: <port>` for dsh-superagent."""
    patch_file = resolve_dsh_home() / 'profiles' / profile / 'cordis.patch.yml'
    if not patch_file.exists():
        return
    text = patch_file.read_text(encoding='utf-8')
    if re.search(r'^\s*officePort:\s*\d+', text, flags=re.MULTILINE):
        updated = re.sub(r'^(\s*officePort:\s*)\d+', rf'\g<1>{port}', text, flags=re.MULTILINE)
    elif 'dsh-superagent:' in text:
        updated = re.sub(r'(dsh-superagent:[^\n]*\n)', rf'\1    officePort: {port}\n', text, count=1)
    else:
        return
    if updated != text:
        patch_file.write_text(updated, encoding='utf-8')


def office_state(url):
    req = urllib.request.Request(url.rstrip('/') + '/orchestrator/api/state', headers={'x-orchestrator-request': '1'})
    try:
        with urllib.request.urlopen(req, timeout=2) as res:
            return json.load(res)
    except (OSError, ValueError):
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status'])
    parser.add_argument('--profile', default=os.environ.get('DSH_SUPERAGENT_PROFILE') or 'superagent')
    parser.add_argument('--port', type=int, default=int(os.environ.get('DSH_OFFICE_PORT') or DEFAULT_OFFICE_PORT))
    parser.add_argument('--timeout', type=float, default=60)
    args = parser.parse_args()

    office_url = f'http://127.0.0.1:{args.port}'
    if args.action in ('start', 'restart'):
        ensure_office_port(args.profile, args.port)

    proc = subprocess.run([sys.executable, str(SUPERAGENT_SCRIPT), args.action, '--profile', args.profile], check=False)
    if args.action in ('start', 'restart') and proc.returncode in (0, 2, 3):
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            if office_state(office_url) is not None:
                print(f'DSH Pixel Office ready at {office_url}/')
                return proc.returncode
            time.sleep(0.5)
        print(f'DSH Pixel Office not reachable at {office_url}/orchestrator/api/state', file=sys.stderr)
        return 1
    if args.action == 'status':
        st = office_state(office_url)
        print(json.dumps({'officeUrl': office_url, 'officeReady': st is not None}, indent=2))
    return proc.returncode


if __name__ == '__main__':
    sys.exit(main())
